# App
APP_URL=http://localhost:3000            # public origin, used in emails and R2 CORS
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Phase 15 — the storefront host. Both optional: unset means one host, and
# everything is the portal, which is what makes dev and previews work.
# Locally use shop.localhost, which resolves to 127.0.0.1 with no hosts edit.
SHOP_HOST=
SHOP_URL=
AUTO_APPROVE_DOMAIN=                     # optional, e.g. lovinghandsportal.com
SEED_SUPER_ADMIN_EMAIL=                  # your Google email; seed creates this user as SUPER_ADMIN

# Storefront (Phase 17)
SUPPLIER_NAME=                           # displays in footer and account menu
SUPPLIER_EMAIL=                          # displays in footer; used in mailto links
SUPPLIER_PHONE=                          # displays in footer contact column
SUPPLIER_ADDRESS=                        # displays in footer; line breaks as \n

# Neon
DATABASE_URL=                            # pooled connection string (-pooler host)
DIRECT_URL=                              # direct connection string, migrations only

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loving-hands-portal

# Resend
RESEND_API_KEY=
EMAIL_FROM="Loving Hands Portal <portal@lovinghandsportal.com>"

# Anthropic
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5
