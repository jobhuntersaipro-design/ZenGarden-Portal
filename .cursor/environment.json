{
  "name": "Loving Hands Portal",
  "install": "bash scripts/dev/cloud-agent-install.sh",
  "start": "bash scripts/dev/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "neon-proxy",
      "command": "node scripts/dev/neon-local-proxy.mjs"
    },
    {
      "name": "dev",
      "command": "NEON_LOCAL=1 NODE_OPTIONS=\"--import ./scripts/dev/neon-local-preload.mjs\" npm run dev"
    }
  ],
  "ports": [3000, 5433]
}
