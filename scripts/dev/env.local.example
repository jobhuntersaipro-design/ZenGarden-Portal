# Offline fallback only (USE_LOCAL_NEON_PROXY=1). The default path is
# `bash scripts/dev/wire-preview-env.sh`, which writes .env.local from Vercel
# Preview (dev Neon + loving-hands-portal-dev). Do not use these placeholders
# against a real database.
#
# Local Postgres behind scripts/dev/neon-local-proxy.mjs. Other values are
# non-secret placeholders so src/lib/env.ts validates; R2 / Resend / Anthropic /
# Google do nothing until you supply real keys.

# App
APP_URL=http://localhost:3000
AUTH_SECRET=dev-only-not-a-secret-Ag8pQ2m7Zx1KdV5rN0sT4wYbHcJfLkQ=
AUTH_GOOGLE_ID=local-dev-google-id
AUTH_GOOGLE_SECRET=local-dev-google-secret
SHOP_HOST=
SHOP_URL=
AUTO_APPROVE_DOMAIN=
SEED_SUPER_ADMIN_EMAIL=admin@lovinghandsportal.com

# Storefront (optional in dev)
SUPPLIER_NAME=
SUPPLIER_EMAIL=
SUPPLIER_PHONE=
SUPPLIER_ADDRESS=

# Neon — local Postgres via the WebSocket proxy. NEON_LOCAL=1 turns the proxy
# wiring on; it is read at Node startup by the preload, so it must live here.
NEON_LOCAL=1
NEON_LOCAL_PROXY_PORT=5433
DATABASE_URL=postgresql://lovinghands:lovinghands@127.0.0.1:5432/loving_hands_portal
DIRECT_URL=postgresql://lovinghands:lovinghands@127.0.0.1:5432/loving_hands_portal?sslmode=disable

# Cloudflare R2 (placeholder)
R2_ACCOUNT_ID=local-dev-r2-account
R2_ACCESS_KEY_ID=local-dev-r2-access-key
R2_SECRET_ACCESS_KEY=local-dev-r2-secret-key
R2_BUCKET=loving-hands-portal-dev

# Resend (placeholder)
RESEND_API_KEY=local-dev-resend-key
EMAIL_FROM="Loving Hands Portal <portal@lovinghandsportal.com>"

# Anthropic (placeholder)
ANTHROPIC_API_KEY=local-dev-anthropic-key
EXTRACTION_MODEL=claude-sonnet-5
